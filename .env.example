# Salin ke .env lalu isi nilainya. JANGAN commit file .env.

# ---------- App ----------
# development | production
APP_ENV=development
PORT=8080
# debug | info | warn | error
LOG_LEVEL=info
# IP/CIDR proxy yang dipercaya untuk header X-Forwarded-For (pisahkan dengan koma).
# Kosongkan saat lokal.
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Database ----------
# Lokal : postgres://gdgoc:gdgoc@localhost:5432/gdgoc?sslmode=disable
# Neon  : postgres://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgres://gdgoc:gdgoc@localhost:5432/gdgoc?sslmode=disable
DB_MAX_CONNS=10
# Jalankan migrasi otomatis saat startup
AUTO_MIGRATE=true
# Jalankan seed (idempotent) saat startup
SEED_ON_START=true
# Password untuk semua akun uji hasil seed
SEED_PASSWORD=change-me-seed-password

# ---------- Auth ----------
# Minimal 32 karakter. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ISSUER=gdgoc-unsri-core-team-api
JWT_TTL=2h
# Minimal 10
BCRYPT_COST=12

# Rate limit login: maks N percobaan per window per (IP + email)
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=1m

# ---------- Google OAuth (opsional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
# Hanya email dengan domain ini yang boleh login via Google
ALLOWED_EMAIL_DOMAIN=gdgoc-unsri.test
